{
  // Self-contained: this used to `extend` a monorepo-root tsconfig.base.json,
  // but `api/` is now an independent, separately-deployed app with no repo-root
  // config above it, so those base options are inlined here.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": true,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "jsx": "react-jsx",

    // The shared Zod schemas/types now live inside this app at src/shared
    // rather than in a workspace package. Keeping the "@wealthify/shared"
    // specifier (instead of rewriting ~50 import statements to relative
    // paths) means no source churn, and tsx resolves these tsconfig paths at
    // runtime the same way tsc does at compile time.
    "paths": {
      "@wealthify/shared": ["./src/shared/index.ts"],
      "@wealthify/shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
