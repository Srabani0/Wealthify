# Server
NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string (include ?sslmode=require) — use the
# POOLED ("-pooler") host here, the app's runtime connection.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.neon.tech/wealthify?sslmode=require"
# Same credentials but the DIRECT (non-pooled) host — same string with
# "-pooler" removed. Used only by `prisma migrate`; the pooler can behave
# unpredictably for schema-changing operations.
DIRECT_URL="postgresql://user:password@ep-xxxx.neon.tech/wealthify?sslmode=require"

# JWT — generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET="replace-with-a-random-64-character-hex-string"
JWT_EXPIRES_IN="7d"

# Must match the frontend's origin exactly (no trailing slash)
CORS_ORIGIN="http://localhost:5173"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Brevo (optional) — without these, password-reset links are logged to the
# server console instead of emailed, so the flow still works in local dev.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Wealthify"

# Gemini (optional) — without a key, the AI Copilot chat returns a clear
# provider error but the rest of the app is unaffected. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
