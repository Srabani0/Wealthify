{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    // The shared Zod schemas/types now live inside this app at src/shared
    // rather than in a workspace package. The "@wealthify/shared" specifier is
    // kept so no import statements needed rewriting; the matching runtime
    // alias lives in vite.config.ts.
    "paths": {
      "@/*": ["./src/*"],
      "@wealthify/shared": ["./src/shared/index.ts"],
      "@wealthify/shared/*": ["./src/shared/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
